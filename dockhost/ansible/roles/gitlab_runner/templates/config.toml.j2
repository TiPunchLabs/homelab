{{ ansible_managed | comment }}
concurrent = {{ gitlab_runner_concurrent }}
check_interval = 0
shutdown_timeout = 0
log_level = "info"

[[runners]]
  name = "{{ gitlab_runner_name }}"
  url = "{{ gitlab_runner_url }}"
  token = "{{ gitlab_runner_token }}"
  executor = "docker"
  [runners.docker]
    image = "{{ gitlab_runner_default_image }}"
    privileged = false
    tls_verify = false
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    disable_cache = false
    # Never add /var/run/docker.sock here: it would give every job root on dockhost.
    volumes = ["/cache"]
    network_mode = "{{ gitlab_runner_jobs_network }}"
    cpus = "{{ gitlab_runner_job_cpus }}"
    memory = "{{ gitlab_runner_job_memory }}"
    memory_swap = "{{ gitlab_runner_job_memory }}"
    cap_drop = ["NET_RAW"]
    security_opt = ["no-new-privileges:true"]
    shm_size = 0
