{{ ansible_managed | comment }}
[Unit]
Description=GitLab Runner (homelab quota fallback)
# Never start without the job egress filter. BindsTo docker: the foreground
# "compose up" ends with dockerd and systemd brings it back after.
Requires=homelab-ci-egress.service
After=homelab-ci-egress.service docker.service
BindsTo=docker.service

[Service]
WorkingDirectory={{ gitlab_runner_install_dir }}
ExecStartPre=/usr/local/sbin/homelab-ci-egress
ExecStart=/usr/bin/docker compose up --remove-orphans --abort-on-container-exit
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=10
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target docker.service
