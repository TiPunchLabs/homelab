{{ ansible_managed | comment }}
# SECRETS — couche managed, mode 0640 root:{{ hermes_pgid }}, valeurs issues
# d'Ansible Vault. L'agent lit par le groupe et ne peut pas reecrire ce
# fichier : plus strict que le 0600 precedent, qui lui appartenait.
#
# Precedence : le .env managed l'emporte sur le .env du volume ET sur
# l'environnement du shell. Les cles posees ici sont donc definitives ; celles
# qu'ecrit `hermes gateway enroll` dans le volume restent a lui, tant qu'elles
# portent des noms differents.

# Fournisseur d'inference (referencee par `key_env` dans config.yaml)
{{ hermes_provider_key_env }}={{ hermes_deepseek_api_key }}

# Serveur d'API du gateway ({{ hermes_gateway_port }}). Ferme en UFW, mais la
# cle reste une defense en profondeur bon marche.
API_SERVER_ENABLED=true
API_SERVER_KEY={{ hermes_api_server_key }}

# Authentification du dashboard. Obligatoire : Hermes refuse de se lier a une
# interface non-loopback sans fournisseur d'auth enregistre.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME={{ hermes_dashboard_username }}
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD={{ hermes_dashboard_password }}
# Cle de signature des jetons : sans elle, les sessions ne survivent pas a un
# redemarrage du conteneur.
HERMES_DASHBOARD_BASIC_AUTH_SECRET={{ hermes_dashboard_secret }}

# Telegram — liste blanche COMMUNE a tous les profils. Le meme utilisateur
# pilote les cinq bots : epinglee ici, aucun .env de profil ne peut l'elargir.
# Avec elle, Hermes ignore les inconnus au lieu de leur proposer l'appairage.
TELEGRAM_ALLOWED_USERS={{ hermes_telegram_allowed_users }}
# Les deux interrupteurs qui court-circuitent la liste blanche
# (gateway/authz_mixin.py), fermes pour tous les profils.
TELEGRAM_ALLOW_ALL_USERS=false
GATEWAY_ALLOW_ALL_USERS=false

# =============================================================================
# ⚠️ JAMAIS DE TELEGRAM_BOT_TOKEN, D'API_SERVER_PORT NI D'API_SERVER_HOST ICI.
#
# Ce fichier s'applique a TOUS les profils, en dernier et avec override.
#
# - Un TELEGRAM_BOT_TOKEN pose ici impose le bot de default a chaque profil ;
#   or le gateway s6 d'un profil tourne en `gateway run --replace`, qui TUE le
#   detenteur du verrou de jeton. Demarrer un second profil couperait le bot
#   de default. Chaque jeton vit dans le .env de SON profil, ecrit cle par cle
#   (tasks/env_keys.yml).
# - Un API_SERVER_PORT pose ici ferait viser le meme port a toutes les
#   gateways ; le port est propre a chaque profil.
#
# Le controle « Verify the managed scope contract » echoue si l'une de ces
# cles reapparait.
# =============================================================================
