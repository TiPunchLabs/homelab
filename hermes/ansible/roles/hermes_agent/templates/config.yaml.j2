{{ ansible_managed | comment }}
# COUCHE MANAGED — deployee dans {{ hermes_managed_dir }}, montee en lecture
# seule sur /etc/hermes. Hermes fusionne ces cles PAR-DESSUS celles du
# config.yaml du volume de donnees, et elles gagnent a la feuille.
#
# ⚠️ Ne declarer ici que ce qu'Ansible doit epingler. Toute cle ajoutee devient
# inviolable pour l'agent — y compris celles qu'un assistant `hermes ... setup`
# voudrait legitimement gerer de son cote (`platforms:` en particulier).
#
# Les secrets vivent dans .env, jamais ici.

# Fournisseur declare explicitement : endpoint compatible OpenAI de DeepSeek.
# `key_env` ne porte que le NOM de la variable ; le resolveur la lit depuis
# .env, charge dans os.environ au demarrage.
providers:
  {{ hermes_provider_name }}:
    name: {{ hermes_provider_display_name }}
    base_url: {{ hermes_provider_base_url }}
    key_env: {{ hermes_provider_key_env }}
    default_model: {{ hermes_model_default }}

model:
  provider: {{ hermes_provider_name }}
  default: {{ hermes_model_default }}

dashboard:
  # Derriere Caddy : les callbacks et redirections doivent pointer sur l'URL
  # publique, pas sur l'adresse d'ecoute reelle.
  public_url: "{{ hermes_dashboard_public_url }}"
