{{ ansible_managed | comment }}
# Prefixe PERIPHERY_ et non KOMODO_ : l'exemple de compose de la documentation
# amont montre KOMODO_CORE_ADDRESS, c'est errone (ou perime). La config TOML
# de reference v2 annonce bien `Env: PERIPHERY_CORE_ADDRESS`, et le
# compose.env de dockhost — qui tourne — utilise le meme prefixe.

TZ={{ hermes_timezone }}

PERIPHERY_CORE_ADDRESS={{ komodo_core_address }}
PERIPHERY_CONNECT_AS={{ komodo_connect_as }}
PERIPHERY_ROOT_DIRECTORY={{ komodo_periphery_root }}

# Cle a USAGE UNIQUE. Core l'echange au premier contact contre la cle publique
# que Periphery genere, puis la jette. Elle reste ecrite ici sans effet aux
# replays suivants : l'agent s'authentifie desormais avec la cle privee du
# volume `keys`. Voir le README du role pour la procedure de re-onboarding.
PERIPHERY_ONBOARDING_KEY={{ komodo_onboarding_key }}

PERIPHERY_DISABLE_TERMINALS=false
PERIPHERY_DISABLE_CONTAINER_TERMINALS=false

PERIPHERY_LOGGING_PRETTY=false
PERIPHERY_PRETTY_STARTUP_CONFIG=false
