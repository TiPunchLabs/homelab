#!/usr/bin/env bash
# Run a command with credentials read from pass, scoped to that process only.
#
# Usage: scripts/with-secrets <profile>[,<profile>...] -- <command> [args...]
#
# Credentials are exported into this process and inherited by the command only;
# the calling shell (and anything it launches) never sees them. Run it from an
# owner terminal, not from an agent session.
set -euo pipefail
# Never trace: assignments below hold plaintext credentials.
set +x

load() {
  local var=$1 entry=$2 val
  [[ -e $store/$entry.gpg ]] || {
    echo "with-secrets: missing pass entry: $entry (in $store)" >&2
    exit 1
  }
  val=$(pass show "$entry") || {
    echo "with-secrets: cannot read pass entry: $entry (pass/gpg failed, see above)" >&2
    exit 1
  }
  val=${val%%$'\n'*}
  [[ -n $val ]] || {
    echo "with-secrets: empty pass entry: $entry" >&2
    exit 1
  }
  loaded+=("$var=$val")
}

profile_proxmox() {
  load TF_VAR_pm_api_token_id proxmox/terraform-token-id
  load TF_VAR_pm_api_token_secret proxmox/terraform-token-secret
}

profile_lxc() {
  profile_proxmox
  load TF_VAR_ct_root_password proxmox/lxc-root-password
}

profile_github() {
  load TF_VAR_github_token github/terraform-token
}

profile_gitlab() {
  load TF_VAR_gitlab_token gitlab/terraform-token
  load TF_VAR_gitlab_namespace_id gitlab/tipunchlabs-group-id
  load TF_VAR_github_mirror_token github/gitlab-push-mirror-tipunchlabs
}

profile_ovh() {
  load TF_VAR_ovh_application_key tipunchlabs/ovh/application_key
  load TF_VAR_ovh_application_secret tipunchlabs/ovh/application_secret
  load TF_VAR_ovh_consumer_key tipunchlabs/ovh/consumer_key
  load TF_VAR_dynhost_password tipunchlabs/ovh/dynhost_password
  load TF_VAR_portail_current_ip tipunchlabs/ovh/portail_public_ip
}

profile_tfstate() {
  [[ -n ${TF_HTTP_USERNAME:-} ]] || {
    echo "with-secrets: TF_HTTP_USERNAME is not set (expected from .envrc, see .envrc.example)" >&2
    exit 1
  }
  load TF_HTTP_PASSWORD gitlab/terraform-token
}

profile_vault() {
  load ANSIBLE_VAULT_PASSWORD ansible/vault
}

if [[ $# -lt 3 || $2 != "--" ]]; then
  echo "usage: with-secrets <profile>[,<profile>...] -- <command> [args...]" >&2
  cat >&2 <<'USAGE'
profiles (Terraform roots):
  proxmox  dockhost, hermes/terraform-31, kubecluster, vpngate
  lxc      caddy, pihole (proxmox + LXC root password)
  gitlab   gitlab-terraform
  github   TF_VAR_github_token (no tracked github-terraform root)
  ovh      ovh-dns-terraform
  tfstate  GitLab HTTP state backend (dockhost: proxmox,tfstate)
  vault    ANSIBLE_VAULT_PASSWORD
USAGE
  exit 2
fi

store=${PASSWORD_STORE_DIR:-$HOME/.password-store}

loaded=()
IFS=, read -ra profiles <<<"$1"
if [[ ${#profiles[@]} -eq 0 ]]; then
  echo "with-secrets: no profile given" >&2
  exit 2
fi
shift 2

for p in "${profiles[@]}"; do
  if ! declare -F "profile_$p" >/dev/null; then
    echo "with-secrets: unknown profile: $p" >&2
    exit 2
  fi
  "profile_$p"
done

# Export only now, so the pass/gpg processes above never inherit loaded secrets.
for kv in "${loaded[@]}"; do declare -x "$kv"; done
unset loaded kv
exec "$@"
