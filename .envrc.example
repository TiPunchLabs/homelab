# .envrc - Cree et active le venv automatiquement
if [[ ! -d .venv ]]; then
    uv venv
fi
source .venv/bin/activate

# Synchroniser les dependances si uv.lock existe
if [[ -f uv.lock ]]; then
    uv sync
fi

# Configuration non sensible UNIQUEMENT.
# Aucun secret ici : les credentials sont injectes a la demande par
# scripts/with-secrets (lecture de pass, scope limite au process lance).
export PROXMOX_IP=<proxmox-ip>
export TF_VAR_pm_api_url=<https://proxmox-ip:8006/api2/json>
export TF_VAR_github_owner=<github-owner>
export TF_VAR_gitlab_namespace_path=<gitlab-namespace-path>
export TF_HTTP_USERNAME=<gitlab-username>
